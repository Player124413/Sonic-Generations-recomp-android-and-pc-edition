+
+// Step-0 perf timeline (see NATIVE_PLAN.md): accumulates the last flipped
+// frame's perf snapshot on every present, logs averages every 300 presents
+// (same cadence as the FPS meter). WARN level: presets run warning+, so INFO
+// would never reach the shared log; ultra (error-only) stays quiet.
+// Presents without an intervening guest-frame Flip re-add the same snapshot;
+// negligible at the steady-state 1:1 present/frame ratio.
+struct AndroidPerfTotals {
+  int64_t frame_us = 0;
+  int64_t draws = 0;
+  int64_t verts = 0;
+  int64_t tex_hit = 0;
+  int64_t tex_miss = 0;
+  int64_t pipe_hit = 0;
+  int64_t pipe_miss = 0;
+  int64_t dispatched = 0;
+  int64_t interrupts = 0;
+  int64_t xma = 0;
+  int64_t stalls = 0;
+};
+static AndroidPerfTotals g_android_perf_totals;
+static void AndroidPerfTimelineTick() {
+  using rex::perf::CounterId;
+  using rex::perf::GetSnapshotCounter;
+  g_android_perf_totals.frame_us += GetSnapshotCounter(CounterId::kFrameTimeUs);
+  g_android_perf_totals.draws += GetSnapshotCounter(CounterId::kDrawCalls);
+  g_android_perf_totals.verts += GetSnapshotCounter(CounterId::kVerticesProcessed);
+  g_android_perf_totals.tex_hit += GetSnapshotCounter(CounterId::kTextureCacheHits);
+  g_android_perf_totals.tex_miss += GetSnapshotCounter(CounterId::kTextureCacheMisses);
+  g_android_perf_totals.pipe_hit += GetSnapshotCounter(CounterId::kPipelineCacheHits);
+  g_android_perf_totals.pipe_miss += GetSnapshotCounter(CounterId::kPipelineCacheMisses);
+  g_android_perf_totals.dispatched += GetSnapshotCounter(CounterId::kFunctionsDispatched);
+  g_android_perf_totals.interrupts += GetSnapshotCounter(CounterId::kInterruptDispatches);
+  g_android_perf_totals.xma += GetSnapshotCounter(CounterId::kXmaFramesDecoded);
+  g_android_perf_totals.stalls += GetSnapshotCounter(CounterId::kCommandBufferStalls);
+  uint64_t presents = g_android_present_count.load(std::memory_order_relaxed);
+  if ((presents % 300) == 0) {
+    const AndroidPerfTotals& t = g_android_perf_totals;
+    REXLOG_WARN(
+        "PERFDATA presents={} frame_us={} draws={} verts={} tex={}/{} pipe={}/{} disp={} irq={} xma={} stall={}",
+        presents, t.frame_us / 300, t.draws / 300, t.verts / 300, t.tex_hit, t.tex_miss,
+        t.pipe_hit, t.pipe_miss, t.dispatched, t.interrupts, t.xma, t.stalls);
+    g_android_perf_totals = AndroidPerfTotals{};
+  }
+}
 #endif
