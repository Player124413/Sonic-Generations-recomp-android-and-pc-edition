+# Propagate profiling defines globally. Tracy stays compiled out in Release,
+# but the lightweight perf counters are always on (relaxed atomics, ~1 ns
+# each): the Android port reads them for its perf timeline (vulkan_presenter).
 if(REXGLUE_ENABLE_TRACY)
     add_compile_definitions($<$<NOT:$<CONFIG:Release>>:REXGLUE_ENABLE_PROFILING>)
 endif()
 if(REXGLUE_ENABLE_PERF_COUNTERS)
-    add_compile_definitions($<$<NOT:$<CONFIG:Release>>:REXGLUE_ENABLE_PERF_COUNTERS>)
+    add_compile_definitions(REXGLUE_ENABLE_PERF_COUNTERS)
 endif()
